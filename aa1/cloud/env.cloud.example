# Hajimi King - 云端部署环境配置示例
# 适用于 claw.cloud 等云平台部署

# =============================================================================
# 网页版配置 (Web Interface Configuration)
# =============================================================================

# 网页服务端口 (通常云平台会自动分配)
WEB_PORT=5000

# 网页访问密码 (强烈建议修改)
WEB_PASSWORD=your_secure_cloud_password_here

# Flask会话密钥 (必须修改为随机字符串)
WEB_SECRET_KEY=your_random_secret_key_for_cloud_deployment_change_me

# 调试模式 (生产环境必须设为false)
WEB_DEBUG=false

# 启动模式 (both=完整服务, core=仅核心, web=仅网页)
HAJIMI_MODE=both

# =============================================================================
# GitHub 配置 (GitHub Configuration)
# =============================================================================

# GitHub API访问令牌 (必填，多个用逗号分隔)
# 获取方式: https://github.com/settings/tokens
# 权限要求: public_repo
GITHUB_TOKENS=ghp_your_token_1,ghp_your_token_2,ghp_your_token_3

# =============================================================================
# 基础配置 (Basic Configuration)
# =============================================================================

# 数据存储路径 (云端通常使用持久化存储)
DATA_PATH=/app/data

# 仓库年龄过滤 (天数，只扫描指定天数内的仓库)
DATE_RANGE_DAYS=730

# 查询配置文件路径
QUERIES_FILE=queries.txt

# Gemini验证模型
HAJIMI_CHECK_MODEL=gemini-2.5-flash

# =============================================================================
# 代理配置 (Proxy Configuration)
# =============================================================================

# 代理服务器 (云端部署强烈推荐配置代理)
# 格式: http://proxy:port 或 http://user:pass@proxy:port
# 多个代理用逗号分隔
PROXY=http://your-proxy-1:port,http://user:pass@your-proxy-2:port

# =============================================================================
# Gemini Balancer 同步配置
# =============================================================================

# 是否启用Gemini Balancer同步
GEMINI_BALANCER_SYNC_ENABLED=false

# Gemini Balancer服务地址
GEMINI_BALANCER_URL=http://your-gemini-balancer.com

# Gemini Balancer认证密码
GEMINI_BALANCER_AUTH=your_balancer_password

# =============================================================================
# GPT Load Balancer 同步配置
# =============================================================================

# 是否启用GPT Load Balancer同步
GPT_LOAD_SYNC_ENABLED=false

# GPT Load Balancer服务地址
GPT_LOAD_URL=http://your-gpt-load.com

# GPT Load Balancer认证Token
GPT_LOAD_AUTH=your_load_balancer_token

# GPT Load Balancer组名 (多个用逗号分隔)
GPT_LOAD_GROUP_NAME=group1,group2,group3

# =============================================================================
# 高级配置 (Advanced Configuration)
# =============================================================================

# 文件路径黑名单 (过滤不需要扫描的文件)
FILE_PATH_BLACKLIST=readme,docs,doc/,.md,example,sample,tutorial,test,spec,demo,mock

# 有效密钥文件前缀
VALID_KEY_PREFIX=keys/keys_valid_

# 频率限制密钥文件前缀
RATE_LIMITED_KEY_PREFIX=keys/key_429_

# 发送密钥文件前缀
KEYS_SEND_PREFIX=keys/keys_send_

# 详细日志文件前缀
VALID_KEY_DETAIL_PREFIX=logs/keys_valid_detail_
RATE_LIMITED_KEY_DETAIL_PREFIX=logs/key_429_detail_
KEYS_SEND_DETAIL_PREFIX=logs/keys_send_detail_

# 已扫描SHA文件名
SCANNED_SHAS_FILE=scanned_shas.txt

# =============================================================================
# 云平台特定配置 (Cloud Platform Specific)
# =============================================================================

# 容器注册表地址 (如果使用私有注册表)
CONTAINER_REGISTRY=your-registry.com/your-namespace

# Kubernetes命名空间
K8S_NAMESPACE=default

# 持久化存储大小
STORAGE_SIZE=5Gi

# 资源限制
MEMORY_REQUEST=512Mi
MEMORY_LIMIT=1Gi
CPU_REQUEST=250m
CPU_LIMIT=500m

# 健康检查配置
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# =============================================================================
# SSL/TLS 配置 (HTTPS Configuration)
# =============================================================================

# 域名 (用于SSL证书)
DOMAIN=hajimi-king.your-domain.com

# SSL证书颁发者 (Let's Encrypt)
CERT_ISSUER=letsencrypt-prod

# 强制HTTPS重定向
FORCE_SSL_REDIRECT=true

# =============================================================================
# 监控和日志配置 (Monitoring & Logging)
# =============================================================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志格式 (json, text)
LOG_FORMAT=json

# 启用Prometheus监控
ENABLE_METRICS=true

# 监控端口
METRICS_PORT=9090

# =============================================================================
# 安全配置 (Security Configuration)
# =============================================================================

# 运行用户ID (非root用户)
RUN_USER_ID=1000

# 运行组ID
RUN_GROUP_ID=1000

# 安全上下文
SECURITY_CONTEXT_ENABLED=true

# 只读根文件系统
READ_ONLY_ROOT_FILESYSTEM=true

# 禁用特权模式
ALLOW_PRIVILEGE_ESCALATION=false

# =============================================================================
# 备份配置 (Backup Configuration)
# =============================================================================

# 启用自动备份
ENABLE_BACKUP=true

# 备份间隔 (小时)
BACKUP_INTERVAL=24

# 备份保留天数
BACKUP_RETENTION_DAYS=7

# 备份存储位置
BACKUP_STORAGE_PATH=/app/backups

# =============================================================================
# 云端优化配置 (Cloud Optimization)
# =============================================================================

# 启用水平自动扩缩容
ENABLE_HPA=false

# 最小副本数
MIN_REPLICAS=1

# 最大副本数
MAX_REPLICAS=3

# CPU使用率阈值 (触发扩容)
CPU_THRESHOLD=70

# 内存使用率阈值 (触发扩容)
MEMORY_THRESHOLD=80

# 启用Pod中断预算
ENABLE_PDB=true

# 最小可用副本数
MIN_AVAILABLE_REPLICAS=1
