# Hajimi King - 云端部署专用Dockerfile
# 优化了云平台部署的镜像构建

FROM python:3.11-slim

# 设置标签
LABEL maintainer="Hajimi King Team"
LABEL description="Hajimi King - GitHub Gemini Key Scanner with Web Interface"
LABEL version="1.0.0-cloud"

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 创建非root用户（云平台安全要求）
RUN groupadd -r hajimi && useradd -r -g hajimi hajimi

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 先复制依赖文件
COPY pyproject.toml ./

# 安装Python依赖
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    flask>=2.3.0 \
    google-generativeai>=0.8.5 \
    python-dotenv>=1.1.1 \
    requests>=2.32.4 \
    gunicorn>=21.2.0

# 复制项目文件
COPY app/ ./app/
COPY web/ ./web/
COPY common/ ./common/
COPY utils/ ./utils/
COPY start.py ./
COPY queries.example ./queries.txt

# 创建数据目录和日志目录
RUN mkdir -p /app/data/keys /app/data/logs && \
    mkdir -p /var/log/supervisor

# 创建supervisor配置文件（云端优化版）
RUN echo '[supervisord]' > /etc/supervisor/conf.d/supervisord.conf && \
    echo 'nodaemon=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'user=root' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'logfile=/var/log/supervisor/supervisord.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'pidfile=/var/run/supervisord.pid' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[program:hajimi-core]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'command=python app/hajimi_king.py' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'directory=/app' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'user=hajimi' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stderr_logfile=/var/log/supervisor/hajimi-core.err.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile=/var/log/supervisor/hajimi-core.out.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'redirect_stderr=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[program:web-interface]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'command=gunicorn --bind 0.0.0.0:5000 --workers 2 --timeout 120 web.app:app' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'directory=/app' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'user=hajimi' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stderr_logfile=/var/log/supervisor/web-interface.err.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile=/var/log/supervisor/web-interface.out.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'redirect_stderr=true' >> /etc/supervisor/conf.d/supervisord.conf

# 创建健康检查脚本
RUN echo '#!/bin/bash' > /app/healthcheck.sh && \
    echo 'curl -f http://localhost:5000/login || exit 1' >> /app/healthcheck.sh && \
    chmod +x /app/healthcheck.sh

# 设置文件权限
RUN chown -R hajimi:hajimi /app && \
    chmod -R 755 /app

# 暴露端口
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /app/healthcheck.sh

# 启动supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
